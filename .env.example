# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# TMDb Proxy Endpoint (Supabase Edge Function)
# Directs API requests to the secure proxy:
VITE_TMDB_PROXY_URL=https://your-project-id.supabase.co/functions/v1/tmdb

# IMPORTANT SECURITY NOTE:
# TMDB_ACCESS_TOKEN is a server-side secret and must NEVER be placed in any frontend .env file!
# Store it in Supabase Edge Functions using:
# supabase secrets set TMDB_ACCESS_TOKEN="your_tmdb_read_access_token"
